# Fork: container image for self-hosting. See deploy/README.md.
#
# The build needs no database: pages render on demand instead of being
# pre-rendered (Next's compile build mode), which suits a private site.

ARG NODE_VERSION=24

# Dependencies, with the Prisma client generated by postinstall
FROM node:${NODE_VERSION}-bookworm-slim AS deps
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json prisma.config.ts ./
COPY database/schema.prisma database/schema.prisma
RUN npm ci --no-audit --no-fund

# Database tools: prisma db push for first-time setup (compose "tools" profile)
FROM deps AS tools
COPY . .

# Production build
FROM deps AS builder
COPY . .
# Baked into the client bundle at build time
ARG NEXT_PUBLIC_STATIC_URL=/static
ARG NEXT_PUBLIC_STATIC_HOSTNAME=
ENV NEXT_PUBLIC_STATIC_URL=${NEXT_PUBLIC_STATIC_URL} \
    NEXT_PUBLIC_STATIC_HOSTNAME=${NEXT_PUBLIC_STATIC_HOSTNAME} \
    NEXT_OUTPUT=standalone \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_OPTIONS=--max-old-space-size=4096
RUN npx next build --experimental-build-mode compile

# Runtime: the standalone server only
FROM node:${NODE_VERSION}-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    IMAGE_STORAGE_DIR=/data/images
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
RUN mkdir -p /data/images && chown node:node /data/images
USER node
EXPOSE 3000
CMD ["node", "server.js"]
