# Copy to .env next to docker-compose.yml, fill in, and keep it private.
# Generate secrets with: openssl rand -hex 24 (hex is safe everywhere)

# Database password (only used inside the compose network).
# Letters and digits only: it goes into a URL, where / @ : # and similar
# characters break it. openssl rand -hex 24 makes a suitable one.
POSTGRES_PASSWORD=

# The address you open the site on: tailscale serve's https URL
NEXTAUTH_URL=https://hetzner-server1.your-tailnet.ts.net
NEXTAUTH_SECRET=

# Google sign-in. Authorised redirect URI:
#   <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the Storage Box is mounted on the host (rclone-tv.service)
MEDIA_DIR=/mnt/tv

# Optional: REST API for bulk import (API_USER_ID = your user's id)
# API_KEY=
# API_USER_ID=

# Leave unset to keep the site private. true restores upstream's public-site
# behaviour: analytics, search engine pings, crawling.
# PUBLIC_SITE=
